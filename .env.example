# 傳家知保 — 環境變數說明
# 本機開發：複製成 .env.local 填值。正式環境一律在 Vercel 後台設定，不進 git。
# ⚠️ `vercel env pull` 會把敏感變數拉成空字串（例如 AUTH_SECRET），本機開發前先確認沒被蓋掉。

# ── 資料庫（Neon Postgres）──
# Neon 的 pooled 連線字串（主機名含 -pooler）。結構變更：npm run db:generate → npm run db:migrate
DATABASE_URL=

# ── AI ──
ANTHROPIC_API_KEY=

# ── 登入 ──
# JWT 簽名金鑰（隨機長字串）
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── 寄信（Gmail 應用程式密碼）──
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── 排程與內部端點 ──
# GitHub Actions 呼叫 /api/cron/* 與 /api/setup-admin 時帶的密碼
CRON_SECRET=
# /api/admin/seed-drive 用
SEED_SECRET=
APP_URL=
# 每次排程分析的批次大小（預設 8）
DAILY_ANALYZE_LIMIT=

# ── 金流（綠界，RADIA v2 不收費，程式保留）──
ECPAY_ENV=
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=

# ── 檔案儲存（Vercel Blob）──
BLOB_READ_WRITE_TOKEN=

# ── Google Drive（服務帳號，下載條款 PDF）──
GOOGLE_SERVICE_ACCOUNT_JSON=

# ── 保單資料庫目錄（Python pipeline 輸出，含 drive_index.json）──
DB_DIR=

# ── 搬遷期間才需要（Turso → Neon，搬完即可移除）──
# 用唯讀金鑰：turso db tokens create <db> --read-only
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
