# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# SQLite database
data/*.db
data/*.db-shm
data/*.db-wal

# Insurance contracts (PDFs, potentially large/copyrighted)
contracts/
tmp/

# 臨時查詢腳本（scripts/_*.mjs 為一次性 ad-hoc 查詢，不入版控）
scripts/_*.mjs

# 線上資料表備份（含顧問 id，不入版控）
backups/
data/drive_registry.json.bak-3705
